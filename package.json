{
  "name": "appstore-global-price",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "npm run build && node --test",
    "lint": "eslint app functions scripts tests --ignore-pattern out --ignore-pattern .next --ignore-pattern dist --ignore-pattern .tmp",
    "data:fetch": "node scripts/fetch-price-snapshot.mjs --output .tmp/price-snapshot.json",
    "data:check": "node scripts/validate-price-snapshot.mjs --snapshot data/validation-snapshot.json",
    "data:update": "node scripts/update-price-data.mjs",
    "data:add": "node scripts/update-price-data.mjs --reuse-current --app-batch-size 2"
  },
  "dependencies": {
    "@mingcute/react": "^1.4.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
